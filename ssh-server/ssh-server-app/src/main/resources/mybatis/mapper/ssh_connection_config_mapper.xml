<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.johnny.infrastructure.dao.ISshConnectionConfigDao">

    <resultMap id="SshConnectionConfigMap" type="com.johnny.infrastructure.dao.po.SshConnectionConfigPO">
        <id column="id" property="id"/>
        <result column="connection_id" property="connectionId"/>
        <result column="connect_timeout" property="connectTimeout"/>
        <result column="keepalive_interval" property="keepaliveInterval"/>
        <result column="startup_command" property="startupCommand"/>
        <result column="strict_host_key_check" property="strictHostKeyCheck"/>
        <result column="known_hosts" property="knownHosts"/>
        <result column="updated_at" property="updatedAt"/>
    </resultMap>

    <insert id="insert" parameterType="com.johnny.infrastructure.dao.po.SshConnectionConfigPO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ssh_connection_config
            (connection_id, connect_timeout, keepalive_interval, startup_command, strict_host_key_check, known_hosts)
        VALUES
            (#{connectionId}, #{connectTimeout}, #{keepaliveInterval}, #{startupCommand}, #{strictHostKeyCheck}, #{knownHosts})
    </insert>

    <select id="queryByConnectionId" parameterType="java.lang.String" resultMap="SshConnectionConfigMap">
        SELECT id, connection_id, connect_timeout, keepalive_interval, startup_command, strict_host_key_check, known_hosts, updated_at
        FROM ssh_connection_config
        WHERE connection_id = #{connectionId}
    </select>

</mapper>
