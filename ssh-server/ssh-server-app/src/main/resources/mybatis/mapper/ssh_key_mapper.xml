<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.johnny.infrastructure.dao.ISshKeyDao">

    <resultMap id="SshKeyMap" type="com.johnny.infrastructure.dao.po.SshKeyPO">
        <id column="id" property="id"/>
        <result column="key_id" property="keyId"/>
        <result column="name" property="name"/>
        <result column="private_key" property="privateKey"/>
        <result column="passphrase" property="passphrase"/>
        <result column="user_id" property="userId"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <sql id="columns">
        id, key_id, name, private_key, passphrase, user_id, created_at, updated_at, deleted
    </sql>

    <insert id="insert" parameterType="com.johnny.infrastructure.dao.po.SshKeyPO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO ssh_key
            (key_id, name, private_key, passphrase, user_id)
        VALUES
            (#{keyId}, #{name}, #{privateKey}, #{passphrase}, #{userId})
    </insert>

    <update id="update" parameterType="com.johnny.infrastructure.dao.po.SshKeyPO">
        UPDATE ssh_key
        SET name        = #{name},
            private_key = #{privateKey},
            passphrase  = #{passphrase}
        WHERE key_id = #{keyId} AND deleted = 0
    </update>

    <update id="softDeleteByKeyId" parameterType="java.lang.String">
        UPDATE ssh_key
        SET deleted = 1
        WHERE key_id = #{keyId} AND deleted = 0
    </update>

    <select id="queryByKeyId" parameterType="java.lang.String" resultMap="SshKeyMap">
        SELECT <include refid="columns"/>
        FROM ssh_key
        WHERE key_id = #{keyId} AND deleted = 0
    </select>

    <select id="queryByUserId" parameterType="java.lang.String" resultMap="SshKeyMap">
        SELECT <include refid="columns"/>
        FROM ssh_key
        WHERE user_id = #{userId} AND deleted = 0
        ORDER BY id DESC
    </select>

</mapper>
