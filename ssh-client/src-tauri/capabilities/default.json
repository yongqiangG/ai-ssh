{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }],
      "deny": [
        { "path": "$HOME/.ai-ssh" },
        { "path": "$HOME/.ai-ssh/**" }
      ]
    },
    "dialog:default",
    "fs:default",
    "fs:allow-read-file",
    "fs:allow-read-dir",
    "fs:allow-write-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "**" }],
      "deny": [
        { "path": "$HOME/.ai-ssh" },
        { "path": "$HOME/.ai-ssh/**" }
      ]
    },
    "autostart:default"
  ]
}
