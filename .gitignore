# ---- IDE ----
.idea/
*.iml
.vscode/

# ---- Claude Code 个人本机配置（团队共享的 settings.json 可入库）----
**/.claude/settings.local.json
# 第三方 skill 为本机工具链，不入库（按需用 uipro init 自行安装）
.claude/skills/

# ---- OS ----
.DS_Store
Thumbs.db

# ---- 运行时产物 / 日志 ----
hs_err_pid*.log
replay_pid*.log
.playwright-mcp/
data/

# ---- 构建产物（兜底，子模块各自 .gitignore 已覆盖）----
target/
build/
dist/
node_modules/
# resources 下 backend/runtime 是构建期填充产物不入库；
# conpty 是随源码走版本控制的侧载二进制（AI Coding 功能，迁移自 nezha）
ssh-client/src-tauri/resources/*
!ssh-client/src-tauri/resources/conpty

# 反编译参考源码（上游 jar 可复现，不入库）
/decompiled/

